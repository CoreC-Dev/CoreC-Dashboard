# EditorConfig — formatting authority for files not owned by gofmt/biome
# (.yaml, .md, .sh, .json). H6-L3, quality audit 2026-10-21.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
# gofmt owns Go formatting entirely
indent_style = tab

[*.{ts,tsx,js,mjs,json,jsonc}]
# biome owns TS/JS formatting
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sh]
indent_style = space
indent_size = 2
